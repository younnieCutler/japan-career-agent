# Stop tracking everything except for the skill folders and core repository files

# Ignore everything in the root
/*

# Exception: Core repository files
!/.gitignore
!/README.md
!/README_ko.md
!/README_ja.md
!/LICENSE
!/CLAUDE.md
!/AGENTS.md
!/requirements.txt
!/requirements.lock
!/requirements-dev.lock
!/sbom.cdx.json
!/CONTRIBUTING.md
!/CHANGELOG.md
!/examples/
!/examples/**
!/docs/
!/docs/**

# Exception: CI
!/.github/

# Exception: tracked Git hooks (opt-in via `git config core.hooksPath .githooks`)
!/.githooks/

# Exception: Plugin manifests
!/.claude-plugin/
!/.codex-plugin/

# Exception: Shared infrastructure
!/_shared/
!/scripts/
!/hooks/

# Exception: Skill folders
!/skills/

# jiko-bunseki writes personal self-analysis output — keep runtime output out of git
/skills/jiko-bunseki/data/
/skills/jiko-bunseki/career-docs/

# judge pilot run outputs — advisory, non-reproducible scores; keep them out of git
/skills/job-seeker-agent/tests/runs/

# data/ is gitignored — contains personal resume/profile data
# Only the README files inside data/ are tracked
!/data/
/data/candidate_profile.yml
/data/match_history.md
/data/company_profiles/*.yml
/data/pipeline.yml

# Career Agent local event ledger and snapshots
/career-home/

# OS and other generated files (still in ignore list)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
__pycache__/
node_modules/
dist/
build/
.gstack/
.gemini/
.claude/
.agents/
!/.agents/
/.agents/PRE_COMMIT_CHECKLIST.md
!/.agents/plugins/
!/.agents/plugins/marketplace.json
tmp/
*.webp

# --- Personal career document guard (docs/PRIVATE_CAREER_DATA_PRD.md §15.0) ---
# Layer 1 of defense in depth: stop the ordinary accident of dropping a real resume, payslip,
# or certificate into a source directory. The rules below deliberately sit AFTER the `!/docs/`,
# `!/skills/`, `!/scripts/` re-inclusions above, because the last matching pattern wins — those
# re-included directories are exactly where an ignore rule is still needed.
#
# This layer does NOT cover `git add -f`, files that are already tracked, or generically named
# files. Those are `scripts/check_private_data.py` (§15.2) and the commit hook (§15.3).

# Document formats that carry personal career data. No such file is tracked today.
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.odt
*.rtf

# Japanese personal-document filename tokens. These are document names, never source names.
*履歴書*
*職務経歴書*
*エントリーシート*
*給与明細*
*源泉徴収*

# Romanized equivalents, scoped so ordinary source names cannot collide: a bare `*cv*` would
# match `recv.py`, and a bare `*resume*` would match a future `resume_parser.py`.
*[Pp]ayslip*
[Cc][Vv].*
*-[Cc][Vv].*
*_[Cc][Vv].*
[Rr]esume.*
*-[Rr]esume.*
*_[Rr]esume.*

# A private store must never resolve inside a worktree (§15.1); if one does, do not track it.
**/private/

# Synthetic fixtures stay tracked (§13.3). Scoped to the `.example.` infix on purpose: a blanket
# `!/examples/**` here would re-include a real `examples/payslip.pdf`, turning the synthetic
# allowlist into a hole. Ordinary example sources (`.yml`, `.py`, `.md`) match none of the rules
# above and stay tracked via the `!/examples/` re-inclusion near the top of this file.
!*.example.*
